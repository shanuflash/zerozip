#include <winres.h>
#include "resource.h"

IDI_APP ICON "..\\assets\\zerozip.ico"

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "zerozip.manifest"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION ZEROZIP_VERSION
 PRODUCTVERSION ZEROZIP_VERSION
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "ZeroZip - extract big zips on nearly full drives"
            VALUE "FileVersion", ZEROZIP_VERSION_STR
            VALUE "ProductName", "ZeroZip"
            VALUE "ProductVersion", ZEROZIP_VERSION_STR
            VALUE "OriginalFilename", "ZeroZip.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
